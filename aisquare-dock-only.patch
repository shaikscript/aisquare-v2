@@ -0,0 +1,109 @@
+import React from 'react';
+import { useLocation } from 'react-router-dom';
+import {
+  Home,
+  Compass,
+  Layers,
+  Briefcase,
+  Mail,
+  GraduationCap,
+  UserRound,
+  ShieldCheck,
+  ArrowUpRight,
+} from 'lucide-react';
+import { Dock } from './Dock.jsx';
+import { useAuth } from '../context/AuthContext.jsx';
+
+export default function PublicDock() {
+  const location = useLocation();
+  const { user } = useAuth();
+  const isTracksHash = location.pathname === '/' && location.hash === '#tracks';
+
+  const items = [
+    {
+      label: 'Overview',
+      icon: <Home />,
+      to: '/',
+      active: location.pathname === '/' && !isTracksHash,
+    },
+    {
+      label: 'Vision',
+      icon: <Compass />,
+      to: '/about',
+      active: location.pathname === '/about',
+    },
+    {
+      label: 'Evaluation Roles',
+      icon: <Layers />,
+      to: '/#tracks',
+      active: isTracksHash,
+    },
+    {
+      label: 'Careers',
+      icon: <Briefcase />,
+      to: '/careers',
+      active: location.pathname === '/careers',
+    },
+    {
+      label: 'Contact',
+      icon: <Mail />,
+      to: '/contact',
+      active: location.pathname === '/contact',
+      separator: true,
+    },
+  ];
+
+  if (user) {
+    items.push({
+      label:
+        user.role === 'admin'
+          ? 'Admin Console'
+          : user.accountType === 'candidate'
+          ? 'Exam Portal'
+          : 'Employee Portal',
+      icon: user.role === 'admin' ? <ShieldCheck /> : <UserRound />,
+      to:
+        user.role === 'admin'
+          ? '/admin'
+          : user.accountType === 'candidate'
+          ? '/exam-portal'
+          : '/portal',
+      active: false,
+    });
+  } else {
+    items.push(
+      {
+        label: 'Exam Portal',
+        icon: <GraduationCap />,
+        to: '/exam-login',
+        active: false,
+      },
+      {
+        label: 'Employee Login',
+        icon: <UserRound />,
+        to: '/login',
+        active: false,
+      }
+    );
+  }
+
+  items.push({
+    label: 'Apply Now',
+    icon: <ArrowUpRight />,
+    to: '/careers',
+    active: false,
+  });
+
+  return (
+    <div className="public-dock-shell">
+      <Dock
+        items={items}
+        iconSize={38}
+        distance={110}
+        magnification={1.65}
+        borderRadius={14}
+        ariaLabel="Quick public navigation"
+      />
+    </div>
+  );
+}
